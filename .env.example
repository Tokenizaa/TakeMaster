# NVIDIA NIM
# Hosted NIM uses the OpenAI-compatible Chat Completions endpoint.
# NIM_API_KEY is the only required secret. NVIDIA_API_KEY is read as a fallback alias.
NIM_API_KEY="YOUR_NVIDIA_API_KEY"
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"
NIM_BASE_URL="https://integrate.api.nvidia.com"
# Primary: Nemotron 3 Super. Verified working (HTTP 200, JSON mode OK).
NIM_PRIMARY_MODEL="nvidia/nemotron-3-super-120b-a12b"
# Fallback: Nemotron 3 Ultra. The previous ID nvidia/nemotron-3-nano-30b-a3b went EOL on
# 2026-09-01 (HTTP 410) and the 30B-A3B class could not complete real payloads in the
# 60s timeout. See docs/AUDIT_AI_NVIDIA_NIM.md.
NIM_FALLBACK_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
NIM_TIMEOUT_MS="60000"

# APP_URL: The URL where this app is hosted.
APP_URL="YOUR_APP_URL"

# Supabase server-side persistence (NEVER expose the service-role key to the browser)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
